# Reference only: the app reads process environment variables, not this file.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Required when DJANGO_DEBUG=0. Generate a unique random secret outside Git.
DJANGO_SECRET_KEY=
# Optional absolute paths; defaults are inside the ignored data directory.
# DATA_ROOT=D:/PerformingArtsCV-data
# PRIVATE_MEDIA_ROOT=D:/PerformingArtsCV-media
MAX_UPLOAD_BYTES=200000000
PUBLIC_BASE_URL=http://127.0.0.1:8000
ZARINPAL_SANDBOX=1
ZARINPAL_MERCHANT_ID=
# Only enable behind a trusted reverse proxy bound to the local app.
TRUST_PROXY_HTTPS=0
# Request limits are database-backed and can be tuned per deployment.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW=3600
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW=3600
CHECKOUT_RATE_LIMIT=5
CHECKOUT_RATE_WINDOW=900
SUPPORT_RATE_LIMIT=5
SUPPORT_RATE_WINDOW=3600
# Default is local console output; configure an approved provider outside Git.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=webmaster@localhost

# Replace example.test only after the owner chooses a domain.
example.test {
    encode gzip
    request_body {
        max_size 205MB
    }
    handle_path /static/* {
        root * /srv/performingartscv/staticfiles
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# Do not add a route for /srv/performingartscv/private-media.
